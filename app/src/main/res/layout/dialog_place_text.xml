<?xml version="1.0" encoding="utf-8"?>
<!-- Редагування тексту в стилі Samsung Notes (Screen_Recording_20261115_110502):
     1) Текст вводиться прямо на сторінці документа у легкій активній рамці (placeTextEditorBox) з живим розміром (8..64+ pt) і кольором.
     2) Безпосередньо над клавіатурою (за WindowInsets ime) прикріплена темна овальна панель-пігулка (placeTextCard) з усіма інструментами:
        [Перо] [Галочка] [Текст] [Колір шрифту T] [Aa▾] [15▾] [⚙] [↶] [↷] [✓].
     3) Над панеллю відкриваються плаваючі контекстні картки: вертикальний список кеглів (placeTextSizePopup),
        картка «Колір шрифту» з галочкою ✓, власною палітрою, кнопкою ✕ і крапками сторінок (placeTextColorPopup),
        та картка пресетів стилів (placeTextStylePopup). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/placeTextRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false">

    <!-- Живе поле введення тексту безпосередньо на сторінці (позиціонується над панеллю редагування, переміщується тапом, масштабує шрифт при зміні розміру поля) -->
    <LinearLayout
        android:id="@+id/placeTextEditorBox"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_onpage_text_box"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <!-- Залишено для сумісності біндингу -->
        <TextView
            android:id="@+id/placeTextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/place_text_title"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <ScrollView
                android:id="@+id/placeTextEditorScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fillViewport="false"
                android:scrollbars="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/placeTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/placeTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="@string/text_input_hint"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="6"
                        android:minHeight="40dp"
                        android:padding="4dp"
                        android:textColor="#111827"
                        android:textColorHint="#6B7280" />
                </com.google.android.material.textfield.TextInputLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnTextCancel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_cancel"
                    android:padding="14dp"
                    android:src="@drawable/ic_close"
                    app:tint="#6B7280" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnTextBoxResize"
                    android:layout_width="@dimen/place_swatch_size"
                    android:layout_height="@dimen/place_swatch_size"
                    android:contentDescription="@string/place_text_size_menu"
                    android:padding="14dp"
                    android:src="@drawable/ic_resize_corner"
                    app:tint="#4A80F0" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Компактна плаваюча картка «Колір тексту» / «Фон шрифту» (піднята вище, зменшена по висоті за зразком Samsung Notes) -->
    <LinearLayout
        android:id="@+id/placeTextColorPopup"
        android:layout_width="304dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="112dp"
        android:background="@drawable/bg_place_card"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:theme="@style/ThemeOverlay.Material3.Dark"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTextColorPopupTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/place_text_color_toggle"
                android:textColor="@color/place_card_on"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnTextColorClose"
                android:layout_width="@dimen/place_swatch_size"
                android:layout_height="@dimen/place_swatch_size"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/action_cancel"
                android:padding="14dp"
                android:src="@drawable/ic_close"
                app:tint="@color/place_card_on" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/placeTextColorScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/placeTextColorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/placeTextColorDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:id="@+id/dotColorPage1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_place_slot" />

            <View
                android:id="@+id/dotColorPage2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_margin="3dp"
                android:alpha="0.35"
                android:background="@drawable/bg_place_slot" />
        </LinearLayout>
    </LinearLayout>

    <!-- Плаваюча картка пресетів стилів «Aa▾» -->
    <LinearLayout
        android:id="@+id/placeTextStylePopup"
        android:layout_width="228dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:background="@drawable/bg_place_card"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingVertical="8dp"
        android:theme="@style/ThemeOverlay.Material3.Dark"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/placeTextStyleList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Плаваюча вертикальна картка вибору розміру шрифту «15▾» (кадри 00:04, 00:08, 00:12, 00:14 відео) -->
    <ScrollView
        android:id="@+id/placeTextSizePopup"
        android:layout_width="112dp"
        android:layout_height="216dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="64dp"
        android:background="@drawable/bg_place_card"
        android:clickable="true"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:focusable="false"
        android:paddingVertical="8dp"
        android:scrollbars="none"
        android:theme="@style/ThemeOverlay.Material3.Dark"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/placeTextSizeList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Головна однорядкова темна панель-пігулка безпосередньо над клавіатурою (кадри 00:00–00:28 відео) -->
    <LinearLayout
        android:id="@+id/placeTextCard"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_keyboard_toolbar_pill"
        android:baselineAligned="false"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:theme="@style/ThemeOverlay.Material3.Dark">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/placeTextFormatRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnKbToolPen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_tool_ink"
                    android:src="@drawable/ic_draw"
                    app:tint="@color/place_card_on" />

                <ImageButton
                    android:id="@+id/btnKbToolCheck"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_tool_check"
                    android:src="@drawable/ic_check"
                    app:tint="@color/place_card_on"
                    tools:ignore="PrivateResource" />

                <ImageButton
                    android:id="@+id/btnKbToolText"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_tool_text"
                    android:src="@drawable/ic_text_fields"
                    android:visibility="gone"
                    app:tint="@color/place_slot_tint" />

                <com.savoj.volumpdf.ui.reader.SwatchView
                    android:id="@+id/btnTextColor"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_text_color_toggle" />

                <com.savoj.volumpdf.ui.reader.SwatchView
                    android:id="@+id/btnTextBgColor"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_text_bg_color_toggle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTextStyle"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:paddingHorizontal="5dp"
                    android:contentDescription="@string/place_text_style_menu"
                    android:text="Aa"
                    android:textAllCaps="false"
                    android:textColor="@color/place_card_on"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_arrow_drop_down"
                    app:iconGravity="end"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/place_card_on"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTextSize"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:paddingHorizontal="5dp"
                    android:contentDescription="@string/place_text_size_menu"
                    android:textColor="@color/place_card_on"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_arrow_drop_down"
                    app:iconGravity="end"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/place_card_on"
                    tools:text="15" />

                <ImageButton
                    android:id="@+id/btnKbSizeMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_size_decrease"
                    android:src="@drawable/ic_tune"
                    android:visibility="gone"
                    app:tint="@color/place_card_on" />

                <ImageButton
                    android:id="@+id/btnTextUndo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/action_undo"
                    android:src="@drawable/ic_undo"
                    app:tint="@color/place_card_icon_tint" />

                <ImageButton
                    android:id="@+id/btnTextRedo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/action_redo"
                    android:src="@drawable/ic_redo"
                    app:tint="@color/place_card_icon_tint" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/placeTextControls"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTextConfirm"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:contentDescription="@string/place_text_add"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/place_card_accent"
                tools:ignore="PrivateResource" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
