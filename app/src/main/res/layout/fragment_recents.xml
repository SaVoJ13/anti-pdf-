<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLibraryContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Виразний блок «Продовжити читання» для останнього відкритого документа -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardContinueReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1.5dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvContinueBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tool_icon_container"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/continue_reading_title"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textStyle="bold" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardContinueThumbnail"
                            android:layout_width="60dp"
                            android:layout_height="84dp"
                            app:cardBackgroundColor="?attr/colorSurfaceVariant"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/ivContinueThumbnail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/continue_reading_title"
                                android:padding="12dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_pdf_document"
                                app:tint="?attr/colorPrimary" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvContinueTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:ellipsize="middle"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/cardContinueThumbnail"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="Contract_Agreement_2026.pdf" />

                        <TextView
                            android:id="@+id/tvContinuePageInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/cardContinueThumbnail"
                            app:layout_constraintTop_toBottomOf="@id/tvContinueTitle"
                            tools:text="Стор. 5 з 20 • 25%" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressContinueReading"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            app:indicatorColor="?attr/colorPrimary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/cardContinueThumbnail"
                            app:layout_constraintTop_toBottomOf="@id/tvContinuePageInfo"
                            app:trackColor="?attr/colorPrimaryContainer"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="6dp"
                            tools:progress="25" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnContinueReading"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/action_continue_reading"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_chevron_right"
                        app:iconGravity="textEnd" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Заголовок розділу «Нещодавні» -->
            <LinearLayout
                android:id="@+id/layoutSectionRecentsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSectionRecentsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_recent_documents"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnBackground"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSectionRecentsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tool_icon_container"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="4" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearHistory"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="@string/action_clear_history_short"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Список нещодавніх документів -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewRecents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Корисний порожній стан та окремий стан порожнього пошуку -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_tool_icon_container">

            <ImageView
                android:id="@+id/ivEmptyIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_empty_recents"
                app:tint="?attr/colorPrimary" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/empty_recents_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:text="@string/empty_recents_desc"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyOpen"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:minWidth="220dp"
            android:text="@string/action_open_pdf"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_open_pdf" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyScan"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:minWidth="220dp"
            android:text="@string/scan_empty_action"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_camera_scan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyCreate"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:minWidth="220dp"
            android:text="@string/action_create_pdf"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_note_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearSearch"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="@string/action_clear_search"
            android:visibility="gone"
            app:cornerRadius="12dp" />

    </LinearLayout>

</FrameLayout>
