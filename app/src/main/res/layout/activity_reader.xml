<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/readerRoot"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/action_back"
        app:title="@string/reader_title"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
        app:titleTextColor="?attr/colorOnSurface" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <FrameLayout
        android:id="@+id/viewerWrapper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Контейнер PdfViewerFragment -->
        <FrameLayout
            android:id="@+id/pdfViewerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Оверлей незбережених ✓/✗ і тексту (режим «Поставити»); дотики не перехоплює -->
        <com.savoj.volumpdf.ui.reader.MarkupOverlayView
            android:id="@+id/markupOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- Екран «Не вдалося відкрити файл»: накриває переглядач, поки документ не відкрився (P0-3) -->
        <ScrollView
            android:id="@+id/openErrorPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:clickable="true"
            android:fillViewport="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="32dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pdf_document"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/openErrorTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:text="@string/open_error_title"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/openErrorFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/openErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenErrorRetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="48dp"
                    android:text="@string/open_error_retry" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenErrorPick"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/open_error_pick" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenErrorClose"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/open_error_close" />
            </LinearLayout>
        </ScrollView>

        <!-- Ненав'язлива плаваюча панель швидкого доступу: номер сторінки, масштаб і пошук -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReaderHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="0dp">

                <!-- Цілі натискання 48 dp (P0-4): висота 48 dp, вигляд кнопки лишається 36 dp за рахунок inset 6 dp -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHudPage"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:insetTop="6dp"
                    android:insetBottom="6dp"
                    android:minWidth="64dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="10dp"
                    android:text="1 / 1"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:background="?attr/colorOutlineVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHudZoom"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:insetTop="6dp"
                    android:insetBottom="6dp"
                    android:minWidth="56dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="10dp"
                    android:text="100%"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:background="?attr/colorOutlineVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHudSearch"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/action_search"
                    android:insetLeft="6dp"
                    android:insetTop="6dp"
                    android:insetRight="6dp"
                    android:insetBottom="6dp"
                    app:icon="@drawable/ic_search"
                    app:iconSize="18dp"
                    app:iconTint="?attr/colorPrimary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- М1: єдина плаваюча кнопка читача «Редагувати» (власна іконка-олівець). Праворуч, НАД пігулкою сторінки
             (12 dp + 48 dp пігулка + 12 dp), щоб не перекривати її за жодного шрифту й ширини; у режимі «Редагувати» зникає. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabReaderEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="72dp"
            android:contentDescription="@string/reader_edit_fab_desc"
            android:tooltipText="@string/action_place"
            app:backgroundTint="?attr/colorPrimary"
            app:elevation="6dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_fab_edit"
            app:tint="?attr/colorOnPrimary" />

        <!-- Компактна панель дій виділеного об'єкта: лише іконки, розташовується біля об'єкта (див. SelectionPill) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selectionBarCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp">

                <ImageButton
                    android:id="@+id/btnSelDelete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/place_delete"
                    android:scaleType="center"
                    android:src="@drawable/ic_delete"
                    app:tint="?attr/colorOnSurface"
                    android:tooltipText="@string/place_delete" />
                <ImageButton
                    android:id="@+id/btnSelEdit"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/place_edit_text"
                    android:scaleType="center"
                    android:src="@drawable/ic_edit"
                    app:tint="?attr/colorOnSurface"
                    android:tooltipText="@string/place_edit_text" />
                <ImageButton
                    android:id="@+id/btnSelRotateLeft"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_rotate_counterclockwise"
                    android:scaleType="center"
                    android:src="@drawable/ic_rotate_left"
                    app:tint="?attr/colorOnSurface"
                    android:tooltipText="@string/action_rotate_counterclockwise"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btnSelRotateRight"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_rotate_clockwise"
                    android:scaleType="center"
                    android:src="@drawable/ic_rotate_right"
                    app:tint="?attr/colorOnSurface"
                    android:tooltipText="@string/action_rotate_clockwise"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btnSelFitPage"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_fit_page"
                    android:scaleType="center"
                    android:src="@drawable/ic_fit_page"
                    app:tint="?attr/colorOnSurface"
                    android:tooltipText="@string/action_fit_page"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btnSelMovePage"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/place_move_to_page"
                    android:scaleType="center"
                    android:src="@drawable/ic_move_to_page"
                    app:tint="?attr/colorOnSurface"
                    android:tooltipText="@string/place_move_to_page" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Тло-«скрим» картки: тап поза карткою її закриває; видимий лише поки картка відкрита -->
        <View
            android:id="@+id/placeCardScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- Темна плаваюча картка параметрів інструмента: з'являється над нижнім рядком лише за повторним тапом -->
        <!-- Картка прокручується: у ландшафті та при великому шрифті вміст не вміщається по висоті -->
        <ScrollView
            android:id="@+id/placeOptionsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="@dimen/place_card_margin"
            android:background="@drawable/bg_place_card"
            android:clickable="true"
            android:elevation="@dimen/place_card_elevation"
            android:fillViewport="false"
            android:focusable="false"
            android:overScrollMode="ifContentScrolls"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/place_card_padding"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOptionsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/place_card_on" />

                <ImageButton
                    android:id="@+id/btnOptionsClose"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/place_options_close"
                    android:scaleType="center"
                    android:src="@drawable/ic_close"
                    app:tint="@color/place_card_on" />
            </LinearLayout>

            <!-- Вибір дії: ✓, ✗, підпис, зображення -->
            <LinearLayout
                android:id="@+id/placeSecChooser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="12dp">
                <ImageButton
                    android:id="@+id/btnToolCheck"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_tool_check"
                    android:scaleType="center"
                    android:src="@drawable/ic_check"
                    app:tint="@color/place_card_icon_tint" />
                <ImageButton
                    android:id="@+id/btnToolCross"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_tool_cross"
                    android:scaleType="center"
                    android:src="@drawable/ic_close"
                    app:tint="@color/place_card_icon_tint" />
                <ImageButton
                    android:id="@+id/btnToolSignature"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_tool_signature"
                    android:scaleType="center"
                    android:src="@drawable/ic_signature"
                    app:tint="@color/place_card_icon_tint" />
                <ImageButton
                    android:id="@+id/btnToolImage"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_tool_image"
                    android:scaleType="center"
                    android:src="@drawable/ic_image"
                    app:tint="@color/place_card_icon_tint" />
            </LinearLayout>

            <!-- Товщина / розмір: кнопки «−» та «+» обабіч слайдера зі значенням у кружечку на повзунку -->
            <LinearLayout
                android:id="@+id/placeSecSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="0dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tvSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/place_card_muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSizeMinus"
                        android:layout_width="@dimen/place_slot_min_size"
                        android:layout_height="@dimen/place_slot_min_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/place_size_decrease"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/place_card_on"
                        android:textSize="22sp"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/placeSizeSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:stepSize="0"
                        android:value="2"
                        android:valueFrom="0.5"
                        android:valueTo="40"
                        app:haloColor="#33BAC3FF"
                        app:labelBehavior="visible"
                        app:thumbColor="@color/place_card_accent"
                        app:tickVisible="false"
                        app:trackColorActive="@color/place_card_accent"
                        app:trackColorInactive="#4D6B7090" />

                    <TextView
                        android:id="@+id/btnSizePlus"
                        android:layout_width="@dimen/place_slot_min_size"
                        android:layout_height="@dimen/place_slot_min_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/place_size_increase"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/place_card_on"
                        android:textSize="22sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>

            <!-- Кольори: 9 + власний, у два рядки по 5 -->
            <GridLayout
                android:id="@+id/placeColorGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="5"
                android:orientation="horizontal" />

            <!-- Пресети товщини/прозорості пера (наявні: ручка, маркер, хайлайтер) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/placeInkPresetGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                app:selectionRequired="false"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInkPen"
                    style="@style/Widget.VolumPdf.CardChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brush_pen" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInkMarker"
                    style="@style/Widget.VolumPdf.CardChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brush_marker" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInkHighlighter"
                    style="@style/Widget.VolumPdf.CardChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brush_highlighter" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- «Випрямлення ліній» -->
            <LinearLayout
                android:id="@+id/placeSecStraighten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/place_slot_min_size"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/place_straighten"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/place_card_on" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchStraighten"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/place_slot_min_size"
                    android:contentDescription="@string/place_straighten" />
            </LinearLayout>

            <!-- Керування виділеним зображенням: поворот, кут, на всю сторінку -->
            <LinearLayout
                android:id="@+id/placeImageBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/btnOptRotateLeft"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_rotate_counterclockwise"
                    android:scaleType="center"
                    android:src="@drawable/ic_rotate_left"
                    app:tint="@color/place_card_on" />

                <TextView
                    android:id="@+id/tvImageRotationAngle"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0°"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/place_card_on" />

                <ImageButton
                    android:id="@+id/btnOptRotateRight"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_rotate_clockwise"
                    android:scaleType="center"
                    android:src="@drawable/ic_rotate_right"
                    app:tint="@color/place_card_on" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptFitPage"
                    style="@style/Widget.VolumPdf.CardChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/action_fit_page"
                    android:text="@string/action_fit_page"
                    app:icon="@drawable/ic_fit_page" />
            </LinearLayout>

            <!-- Індикатор сторінок налаштувань (крапки); лише коли сторінок більше однієї -->
            <LinearLayout
                android:id="@+id/placeDots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="12dp"
                android:visibility="gone" />
        </LinearLayout>
        </ScrollView>

        <!-- Прогрес індикатор при збереженні анотацій -->
        <FrameLayout
            android:id="@+id/savingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_rounded_card"
                android:padding="24dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/savingMessageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/saving_annotations"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            </LinearLayout>
        </FrameLayout>

    </FrameLayout>

    <!-- Панель «Зберегти / Відкинути»: є незбережені зміни (об'єкти або форми); у режимі «Поставити» ховається -->
    <LinearLayout
        android:id="@+id/unsavedBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerHigh"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/unsavedBarText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/unsaved_bar_text"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnsavedDiscard"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/place_discard" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnsavedSave"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/action_save" />
    </LinearLayout>

    <!-- Єдиний нижній рядок інструментів режиму «Редагувати»: на всю ширину, над системною навігацією.
         Порядок: текст, перо, [маркер: місце зарезервоване, A2 потребує ядра], видалити, виділення, дія, скасувати,
         повторити, параметри. Слоти ≥ 48 dp; на вузьких екранах рядок прокручується. -->
    <HorizontalScrollView
        android:id="@+id/placeToolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/place_bar_bg"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/placeToolBarRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSlotText"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_tool_text"
                android:scaleType="center"
                android:src="@drawable/ic_text_fields"
                app:tint="@color/place_slot_tint" />

            <ImageButton
                android:id="@+id/btnSlotPen"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_tool_ink"
                android:scaleType="center"
                android:src="@drawable/ic_draw"
                app:tint="@color/place_slot_tint" />

            <!-- A2: тут буде «Маркер/підкреслення» (потрібне ядро); поки місце зарезервоване без кнопки -->
            <Space
                android:id="@+id/placeSlotMarkerReserved"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnSlotDelete"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_delete"
                android:scaleType="center"
                android:src="@drawable/ic_delete"
                app:tint="@color/place_slot_tint" />

            <ImageButton
                android:id="@+id/btnSlotSelect"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_slot_select"
                android:scaleType="center"
                android:src="@drawable/ic_select"
                app:tint="@color/place_slot_tint" />

            <ImageButton
                android:id="@+id/btnSlotAction"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_slot_action"
                android:scaleType="center"
                android:src="@drawable/ic_check"
                app:tint="@color/place_slot_tint" />

            <ImageButton
                android:id="@+id/btnPlaceUndo"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/action_undo"
                android:scaleType="center"
                android:src="@drawable/ic_undo"
                app:tint="@color/place_slot_tint"
                android:enabled="false" />

            <ImageButton
                android:id="@+id/btnPlaceRedo"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/action_redo"
                android:scaleType="center"
                android:src="@drawable/ic_redo"
                app:tint="@color/place_slot_tint"
                android:enabled="false" />

            <ImageButton
                android:id="@+id/btnSlotOptions"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_options"
                android:scaleType="center"
                android:src="@drawable/ic_tune"
                app:tint="@color/place_slot_tint" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- М1: нижньої панелі більше немає. Порожній відступ висотою в системну навігацію/клавіатуру (див. applyWindowInsets),
         щоб сторінка й панель «Зберегти / Відкинути» не заходили під жести. -->
    <View
        android:id="@+id/readerBottomInset"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:importantForAccessibility="no" />

</LinearLayout>
