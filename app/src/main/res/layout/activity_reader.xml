<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/action_cancel"
        app:title="@string/reader_title"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <FrameLayout
        android:id="@+id/viewerWrapper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Контейнер PdfViewerFragment -->
        <FrameLayout
            android:id="@+id/pdfViewerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Прозоре інтерактивне полотно малювання -->
        <com.savoj.volumpdf.ui.reader.InkCanvasView
            android:id="@+id/inkCanvasView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Плаваюча панель інструментів малювання -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/drawingToolbarCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Рядок 1: Вибір товщини пензля та кольору -->
                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Вибір пензля: Тонка ручка, Маркер, Хайлайтер -->
                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleBrushTypeGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBrushPen"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="@string/brush_pen"
                                android:textSize="12sp"
                                android:paddingHorizontal="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBrushMarker"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="@string/brush_marker"
                                android:textSize="12sp"
                                android:paddingHorizontal="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBrushHighlighter"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="@string/brush_highlighter"
                                android:textSize="12sp"
                                android:paddingHorizontal="10dp" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="8dp"
                            android:background="?attr/colorOutlineVariant" />

                        <!-- Вибір кольору: Червоний, Чорний, Синій, Зелений, Жовтий -->
                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleColorPaletteGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnColorPaletteRed"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="0dp"
                                app:icon="@drawable/ic_check"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="#D32F2F" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnColorPaletteBlack"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="0dp"
                                app:icon="@drawable/ic_check"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="#000000" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnColorPaletteBlue"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="0dp"
                                app:icon="@drawable/ic_check"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="#1976D2" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnColorPaletteGreen"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="0dp"
                                app:icon="@drawable/ic_check"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="#388E3C" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnColorPaletteYellow"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="0dp"
                                app:icon="@drawable/ic_check"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="#FBC02D" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Рядок 2: Кнопки дій: Undo, Очистити, Скасувати/Закрити, Зберегти -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUndoStroke"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:icon="@drawable/ic_undo"
                        android:contentDescription="@string/action_undo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearStrokes"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        app:icon="@drawable/ic_clear_all"
                        android:contentDescription="@string/action_clear_all" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloseDrawing"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/action_cancel"
                        android:textColor="?attr/colorError" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveDrawing"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/action_save"
                        app:icon="@drawable/ic_check" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Прогрес індикатор при збереженні анотацій -->
        <FrameLayout
            android:id="@+id/savingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_rounded_card"
                android:padding="24dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/savingMessageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/saving_annotations"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            </LinearLayout>
        </FrameLayout>

    </FrameLayout>

</LinearLayout>
