<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/readerRoot"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/action_cancel"
        app:title="@string/reader_title"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
        app:titleTextColor="?attr/colorOnSurface" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <FrameLayout
        android:id="@+id/viewerWrapper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Контейнер PdfViewerFragment -->
        <FrameLayout
            android:id="@+id/pdfViewerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Оверлей незбережених ✓/✗ і тексту (режим «Поставити»); дотики не перехоплює -->
        <com.savoj.volumpdf.ui.reader.MarkupOverlayView
            android:id="@+id/markupOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- Ненав'язлива плаваюча панель швидкого доступу: номер сторінки, масштаб і пошук -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReaderHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHudPage"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="64dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="10dp"
                    android:text="1 / 1"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:background="?attr/colorOutlineVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHudZoom"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="56dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="10dp"
                    android:text="100%"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:background="?attr/colorOutlineVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHudSearch"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/action_search"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_search"
                    app:iconSize="18dp"
                    app:iconTint="?attr/colorPrimary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Панель дій виділеного об'єкта: видалити / змінити; колір і розмір — на нижній панелі -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selectionBarCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelDelete"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:text="@string/place_delete"
                            app:icon="@drawable/ic_delete" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelEdit"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:text="@string/place_edit_text"
                            app:icon="@drawable/ic_edit" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelRotateLeft"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/action_rotate_counterclockwise"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:text="@string/action_rotate_left_short"
                            android:visibility="gone"
                            app:icon="@drawable/ic_rotate_left" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelRotateRight"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/action_rotate_clockwise"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:text="@string/action_rotate_right_short"
                            android:visibility="gone"
                            app:icon="@drawable/ic_rotate_right" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelFitPage"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/action_fit_page"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:text="@string/action_fit_page"
                            android:visibility="gone"
                            app:icon="@drawable/ic_fit_page" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelMovePage"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:text="@string/place_move_to_page"
                            app:icon="@drawable/ic_move_to_page" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxWidth="320dp"
                    android:text="@string/place_selected_hint"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Тло-«скрим» картки: тап поза карткою її закриває; видимий лише поки картка відкрита -->
        <View
            android:id="@+id/placeCardScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- Темна плаваюча картка параметрів інструмента: з'являється над нижнім рядком лише за повторним тапом -->
        <!-- Картка прокручується: у ландшафті та при великому шрифті вміст не вміщається по висоті -->
        <ScrollView
            android:id="@+id/placeOptionsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="@dimen/place_card_margin"
            android:background="@drawable/bg_place_card"
            android:clickable="true"
            android:elevation="@dimen/place_card_elevation"
            android:fillViewport="false"
            android:focusable="false"
            android:overScrollMode="ifContentScrolls"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/place_card_padding"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOptionsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/place_card_on" />

                <ImageButton
                    android:id="@+id/btnOptionsClose"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/place_options_close"
                    android:scaleType="center"
                    android:src="@drawable/ic_close"
                    app:tint="@color/place_card_on" />
            </LinearLayout>

            <!-- Вибір дії: ✓, ✗, підпис, зображення -->
            <LinearLayout
                android:id="@+id/placeSecChooser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="12dp">
                <ImageButton
                    android:id="@+id/btnToolCheck"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_tool_check"
                    android:scaleType="center"
                    android:src="@drawable/ic_check"
                    app:tint="@color/place_card_icon_tint" />
                <ImageButton
                    android:id="@+id/btnToolCross"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_tool_cross"
                    android:scaleType="center"
                    android:src="@drawable/ic_close"
                    app:tint="@color/place_card_icon_tint" />
                <ImageButton
                    android:id="@+id/btnToolSignature"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_tool_signature"
                    android:scaleType="center"
                    android:src="@drawable/ic_signature"
                    app:tint="@color/place_card_icon_tint" />
                <ImageButton
                    android:id="@+id/btnToolImage"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="@drawable/bg_place_slot"
                    android:contentDescription="@string/place_tool_image"
                    android:scaleType="center"
                    android:src="@drawable/ic_image"
                    app:tint="@color/place_card_icon_tint" />
            </LinearLayout>

            <!-- Товщина / розмір: слайдер зі значенням у кружечку на повзунку -->
            <LinearLayout
                android:id="@+id/placeSecSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="0dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tvSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/place_card_muted" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/placeSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:stepSize="0"
                    android:value="2"
                    android:valueFrom="0.5"
                    android:valueTo="40"
                    app:haloColor="#33BAC3FF"
                    app:labelBehavior="visible"
                    app:thumbColor="@color/place_card_accent"
                    app:tickVisible="false"
                    app:trackColorActive="@color/place_card_accent"
                    app:trackColorInactive="#4D6B7090" />
            </LinearLayout>

            <!-- Кольори: 9 + власний, у два рядки по 5 -->
            <GridLayout
                android:id="@+id/placeColorGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="5"
                android:orientation="horizontal" />

            <!-- Пресети товщини/прозорості пера (наявні: ручка, маркер, хайлайтер) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/placeInkPresetGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                app:selectionRequired="false"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInkPen"
                    style="@style/Widget.VolumPdf.CardChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brush_pen" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInkMarker"
                    style="@style/Widget.VolumPdf.CardChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brush_marker" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInkHighlighter"
                    style="@style/Widget.VolumPdf.CardChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brush_highlighter" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- «Випрямлення ліній» -->
            <LinearLayout
                android:id="@+id/placeSecStraighten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/place_slot_min_size"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/place_straighten"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/place_card_on" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchStraighten"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/place_slot_min_size"
                    android:contentDescription="@string/place_straighten" />
            </LinearLayout>

            <!-- Керування виділеним зображенням: поворот, кут, на всю сторінку -->
            <LinearLayout
                android:id="@+id/placeImageBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/btnOptRotateLeft"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_rotate_counterclockwise"
                    android:scaleType="center"
                    android:src="@drawable/ic_rotate_left"
                    app:tint="@color/place_card_on" />

                <TextView
                    android:id="@+id/tvImageRotationAngle"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0°"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/place_card_on" />

                <ImageButton
                    android:id="@+id/btnOptRotateRight"
                    android:layout_width="@dimen/place_slot_min_size"
                    android:layout_height="@dimen/place_slot_min_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_rotate_clockwise"
                    android:scaleType="center"
                    android:src="@drawable/ic_rotate_right"
                    app:tint="@color/place_card_on" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptFitPage"
                    style="@style/Widget.VolumPdf.CardChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/action_fit_page"
                    android:text="@string/action_fit_page"
                    app:icon="@drawable/ic_fit_page" />
            </LinearLayout>

            <!-- Індикатор сторінок налаштувань (крапки); лише коли сторінок більше однієї -->
            <LinearLayout
                android:id="@+id/placeDots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="12dp"
                android:visibility="gone" />
        </LinearLayout>
        </ScrollView>

        <!-- Прогрес індикатор при збереженні анотацій -->
        <FrameLayout
            android:id="@+id/savingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_rounded_card"
                android:padding="24dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/savingMessageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/saving_annotations"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            </LinearLayout>
        </FrameLayout>

    </FrameLayout>

    <!-- Панель «Зберегти / Відкинути»: є незбережені зміни (об'єкти або форми); у режимі «Поставити» ховається -->
    <LinearLayout
        android:id="@+id/unsavedBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerHigh"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/unsavedBarText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/unsaved_bar_text"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnsavedDiscard"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/place_discard" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnsavedSave"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/action_save" />
    </LinearLayout>

    <!-- Єдиний нижній рядок інструментів режиму «Редагувати»: на всю ширину, над системною навігацією.
         Порядок: текст, перо, [маркер: місце зарезервоване, A2 потребує ядра], видалити, виділення, дія, скасувати,
         повторити, параметри. Слоти ≥ 48 dp; на вузьких екранах рядок прокручується. -->
    <HorizontalScrollView
        android:id="@+id/placeToolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerHigh"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/placeToolBarRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSlotText"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_tool_text"
                android:scaleType="center"
                android:src="@drawable/ic_text_fields"
                app:tint="@color/place_slot_tint" />

            <ImageButton
                android:id="@+id/btnSlotPen"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_tool_ink"
                android:scaleType="center"
                android:src="@drawable/ic_draw"
                app:tint="@color/place_slot_tint" />

            <!-- A2: тут буде «Маркер/підкреслення» (потрібне ядро); поки місце зарезервоване без кнопки -->
            <Space
                android:id="@+id/placeSlotMarkerReserved"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnSlotDelete"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_delete"
                android:scaleType="center"
                android:src="@drawable/ic_delete"
                app:tint="@color/place_slot_tint" />

            <ImageButton
                android:id="@+id/btnSlotSelect"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_slot_select"
                android:scaleType="center"
                android:src="@drawable/ic_select"
                app:tint="@color/place_slot_tint" />

            <ImageButton
                android:id="@+id/btnSlotAction"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_slot_action"
                android:scaleType="center"
                android:src="@drawable/ic_check"
                app:tint="@color/place_slot_tint" />

            <ImageButton
                android:id="@+id/btnPlaceUndo"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/action_undo"
                android:scaleType="center"
                android:src="@drawable/ic_undo"
                app:tint="@color/place_slot_tint"
                android:enabled="false" />

            <ImageButton
                android:id="@+id/btnPlaceRedo"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/action_redo"
                android:scaleType="center"
                android:src="@drawable/ic_redo"
                app:tint="@color/place_slot_tint"
                android:enabled="false" />

            <ImageButton
                android:id="@+id/btnSlotOptions"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="@dimen/place_slot_min_size"
                android:background="@drawable/bg_place_slot"
                android:contentDescription="@string/place_options"
                android:scaleType="center"
                android:src="@drawable/ic_tune"
                app:tint="@color/place_slot_tint" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Нижня панель швидких дій (Bottom Action Bar) під великий палець -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="8dp"
        app:paddingBottomSystemWindowInsets="false"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_reader_bottom" />

</LinearLayout>
