<?xml version="1.0" encoding="utf-8"?>
<!-- Екран онбордингу прокручується: на шрифті 1,3 і в ландшафті текст не обрізається -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp">

        <FrameLayout
            android:layout_width="@dimen/onboarding_icon_box"
            android:layout_height="@dimen/onboarding_icon_box"
            android:background="@drawable/bg_tool_icon_container"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/ivOnboardingIcon"
                android:layout_width="@dimen/onboarding_icon_size"
                android:layout_height="@dimen/onboarding_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="?attr/colorPrimary"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvOnboardingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/onboarding_title_gap"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOnboardingBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</ScrollView>
